{
  "name": "openai-responses-invalid-argument-string",
  "description": "OpenAI Responses API function_call argument strings that decode to non-objects fall back to empty canonical arguments.",
  "source": "openai-responses",
  "input": {
    "object": "response",
    "status": "completed",
    "output": [
      {
        "type": "function_call",
        "call_id": "call_lookup",
        "name": "lookup_order",
        "arguments": "[\"bad\"]"
      }
    ]
  },
  "expectedOpenAI": [
    {
      "role": "assistant",
      "content": null,
      "tool_calls": [
        {
          "id": "call_lookup",
          "type": "function",
          "function": {
            "name": "lookup_order",
            "arguments": "{}"
          }
        }
      ]
    }
  ],
  "expectedResponse": {
    "finishReason": "tool_calls",
    "usage": {
      "inputTokens": 0,
      "outputTokens": 0
    }
  },
  "expectedWarningCodes": ["invalid-json-arguments"]
}
