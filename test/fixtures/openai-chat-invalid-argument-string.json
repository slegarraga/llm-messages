{
  "name": "openai-chat-invalid-argument-string",
  "description": "OpenAI Chat Completions tool_call argument strings that decode to non-objects fall back to empty canonical arguments.",
  "source": "openai",
  "input": {
    "choices": [
      {
        "message": {
          "role": "assistant",
          "content": null,
          "tool_calls": [
            {
              "id": "call_lookup",
              "type": "function",
              "function": {
                "name": "lookup_order",
                "arguments": "[\"bad\"]"
              }
            }
          ]
        },
        "finish_reason": "tool_calls"
      }
    ]
  },
  "expectedOpenAI": [
    {
      "role": "assistant",
      "content": null,
      "tool_calls": [
        {
          "id": "call_lookup",
          "type": "function",
          "function": {
            "name": "lookup_order",
            "arguments": "{}"
          }
        }
      ]
    }
  ],
  "expectedResponse": {
    "finishReason": "tool_calls",
    "usage": {
      "inputTokens": 0,
      "outputTokens": 0
    }
  },
  "expectedWarningCodes": ["invalid-json-arguments"]
}
